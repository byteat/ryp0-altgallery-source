{
  "$schema": "./sync.schema.json",
  "output": "feed.json",
  "logDir": "logs",
  "stateDir": "state",
  "sources": [
    {
      "name": "ryp0",
      "url": "https://raw.githubusercontent.com/Sami-Wali/ryP0-repository/main/repo.json",
      "schema": "ryp0",
      "required": true
    },
    {
      "name": "altgallery",
      "url": "https://raw.githubusercontent.com/bebound/AltGallery/refs/heads/master/all-apps.json",
      "schema": "altstore",
      "required": false
    },
    {
      "name": "one",
      "url": "https://raw.githubusercontent.com/ios151/One-releases/main/altsource.json",
      "schema": "altstore",
      "required": false
    },
    {
      "name": "insav",
      "url": "https://raw.githubusercontent.com/ios151/Insav-releases/main/altsource.json",
      "schema": "altstore",
      "required": false
    },
    {
      "name": "wqguard",
      "type": "github-releases",
      "repo": "Kianuni/WQGuard",
      "bundleIdentifier": "com.wqguard.app",
      "appName": "WQGuard",
      "developerName": "Kianuni",
      "subtitle": "面向 iOS 26.2+/27.x 的只读沙盒越权检测与 IPA 审查工具",
      "localizedDescription": "WQGuard 是 100% 只读的 iOS 沙盒越权检测、侧载 IPA 审查与固件 CVE 防护工具（Swift，iOS 16+）。",
      "iconURL": "https://raw.githubusercontent.com/Kianuni/WQGuard/main/WQGuard/Resources/Assets.xcassets/AppIcon.appiconset/AppIcon.png",
      "category": "Tools",
      "minOSVersion": "16.0",
      "assetPattern": "\\.ipa$",
      "excludePrerelease": true,
      "maxVersions": 10,
      "required": false
    }
  ],
  "network": {
    "timeout": 30,
    "retries": 4,
    "backoffBase": 2.0,
    "backoffMax": 30,
    "userAgent": "appsource-sync/1.1 (+github actions)"
  },
  "merge": {
    "title": "ryP0 × AltGallery",
    "subtitle": "ryP0 与 AltGallery 等源合并后的镜像",
    "description": "由 GitHub Actions 自动合并 ryP0、AltGallery、One、INSAV 等 AltStore 源，字段结构遵循 ryP0 规范。",
    "identifier": "com.ry0x.source.merged",
    "sourceUrl": "__auto__",
    "iconUrl": "https://raw.githubusercontent.com/Sami-Wali/ryP0-repository/main/icons/ry0_.jpg",
    "tintColor": "#0A84FF",
    "website": "https://github.com/Sami-Wali/ryP0",
    "defaultCategory": "Tools",
    "categoryAliases": {
      "entertainment": "Movies",
      "video": "Movies",
      "utility": "Tools"
    },
    "importedUpdatePolicy": "static",
    "importedAppType": "Static",
    "importedReleaseChannel": "release",
    "keepScreenshots": false,
    "onBundleIdConflict": "merge",
    "preservePrimaryVerbatim": true,
    "strictRyP0Fields": true,
    "dropEmptyVersionApps": true,
    "carryNewsFrom": [
      "ryp0"
    ],
    "preservePrimaryOrder": true,
    "maxVersionsPerApp": 0,
    "excludeBundleIds": [],
    "categoryOverrides": {
      "com.kdt.livecontainer": "Sideloading",
      "com.SideStore.SideStore": "Sideloading"
    }
  },
  "guards": {
    "minAppsAbsolute": 20,
    "minPrimaryAppRatio": 0.8,
    "minTotalAppRatio": 0.9,
    "failOnSecondaryFailure": false,
    "historyLines": 200
  }
}
